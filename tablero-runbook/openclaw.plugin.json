{
  "id": "tablero-runbook",
  "name": "Tablero de Runbook",
  "description": "Guarda y pinta el progreso runbook-progress.v1 que el lead escribe: RPC set/get, tablero HTML y JSON por ruta autenticada del gateway. Sin hooks de agente ni tools.",
  "activation": { "onStartup": true },
  "backupResources": [
    { "disposition": "include", "scope": "state", "relativePath": "tablero-runbook" }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stateDir": {
        "type": "string",
        "default": "C:\\Users\\ehven\\.openclaw-state\\tablero-runbook"
      },
      "fases": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["6"]
      },
      "github": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "ghPath": {
            "type": "string",
            "default": "C:\\Users\\ehven\\.openclaw\\tools\\bin\\gh.exe"
          }
        }
      }
    }
  }
}
