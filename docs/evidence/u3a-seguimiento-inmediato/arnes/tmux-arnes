#!/bin/bash
# Envoltorio de tmux del arnes 19.0: obliga el socket propio (ARNES_SOCKET).
# Los scripts de corrida y el vigilante aceptan TMUX_BIN; con esto ninguna
# llamada suya puede caer en el servidor tmux real.
set -eu
[ -n "${ARNES_SOCKET:-}" ] || { echo "tmux-arnes: ARNES_SOCKET requerido" >&2; exit 1; }
exec /opt/homebrew/bin/tmux -L "$ARNES_SOCKET" "$@"
