  ingenieria:  { model: { primary: "openai/gpt-5.3-codex-spark", fallbacks: ["deepseek/deepseek-v4-flash", "openai/gpt-5.6-sol"] } },
  main:        { model: { primary: "deepseek/deepseek-v4-flash", fallbacks: ["openai/gpt-5.6-sol", "kimi/k3", "zai/glm-5.3", "xai/grok-4.6", "deepseek/deepseek-v4-pro"] } },
