// PROPUESTA 2026-09-16 — NO APLICADA. Ver docs/patches/README.md (sección
// "Primaries repartidos"). Causa: el 2026-09-15 los 8 agentes colgaban de la misma
// llave opencode-go y una cuota agotada frenó toda la flota (cooldown 10 min a 24 h).
// Reglas: ningún proveedor primary de >2 agentes; main/operaciones (negocio) no
// comparten primary con el pipeline; ninguna cadena repite proveedor entre primary y
// primer fallback; FASE B (README): cadena con proveedores distintos, runtime nativo
// (sin openai, sin codex), Anthropic al fondo (último fallback de cada cadena).
// Proveedor = prefijo antes de `/`: opencode-go y opencode cuentan aparte porque son
// dominios de cuota distintos (llave de pago vs free: si opencode-go se agota,
// opencode/free sigue). Todos los ids existen en las cadenas vivas del 2026-09-15
// (docs/patches/modelos-vivos-2026-09-15.json5) y el test lo cruza.
{ agents: { entries: {
  // Negocio: primaries propios, fuera del pipeline.
  main:        { model: { primary: "zai/glm-5.3", fallbacks: ["opencode/glm-5.3-flash", "kimi/k3", "deepseek/deepseek-flash", "xai/grok-4.6", "anthropic/claude-sonnet-5"] } },
  operaciones: { model: { primary: "kimi/k3",     fallbacks: ["opencode/muse-spark-1.3-contributor-free", "zai/glm-5.3", "xai/grok-4.6", "deepseek/deepseek-flash", "anthropic/claude-sonnet-5"] } },
  // Pipeline: como máximo 2 primaries por proveedor (opencode-go y xai llevan 2).
  implementer: { model: { primary: "opencode-go/muse-spark-1.3-contributor", fallbacks: ["deepseek/deepseek-flash", "zai/glm-5.3", "xai/grok-4.6", "opencode/glm-5.3-flash", "anthropic/claude-sonnet-5"] } },
  reviewer:    { model: { primary: "opencode/deepseek-v4-flash",              fallbacks: ["opencode-go/deepseek-v4.1-flash", "kimi/k3", "zai/glm-5.3", "xai/grok-4.6", "anthropic/claude-sonnet-5"] } },
  adversary:   { model: { primary: "xai/grok-4.6",                            fallbacks: ["opencode-go/deepseek-v4.1-flash", "kimi/k3", "zai/glm-5.3", "deepseek/deepseek-flash", "anthropic/claude-sonnet-5"] } },
  verifier:    { model: { primary: "xai/grok-4.6",                            fallbacks: ["deepseek/deepseek-flash", "kimi/k3", "opencode/glm-5.3-flash", "zai/glm-5.3", "anthropic/claude-sonnet-5"] } },
  ingenieria:  { model: { primary: "deepseek/deepseek-flash",                 fallbacks: ["xai/grok-4.6", "opencode/glm-5.3-flash", "kimi/k3", "zai/glm-5.3", "anthropic/claude-sonnet-5"] } },
  scout:       { model: { primary: "opencode-go/deepseek-v4.1-flash",         fallbacks: ["xai/grok-4.6", "opencode/deepseek-v4-flash", "kimi/k3", "zai/glm-5.3", "anthropic/claude-sonnet-5"] } },
} } }
