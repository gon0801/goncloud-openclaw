{
  "id": "summa-gate",
  "name": "Summa Gate",
  "description": "Port del harness summonaikit: merge-guard, sentinel -saikit con recibo de ceremonia, evidencia de verificación, gate de cierre, confinamiento de adversary y tracking de subagentes.",
  "activation": { "onStartup": true },
  "contracts": { "agentToolResultMiddleware": ["openclaw", "codex"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "diagnosticGuard": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": { "enum": ["off", "observe", "enforce"] },
          "requiredProbeCategories": { "type": "integer", "minimum": 3, "maximum": 3 },
          "maxRevisionAttempts": { "type": "integer", "minimum": 1, "maximum": 1 }
        }
      }
    }
  }
}
