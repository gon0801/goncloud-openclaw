<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sincroniza cada noche pstack original (cursor/plugins) en ~/.agents/pstack-oficial y, si la
  copia ya está activa, reapunta las skills (scripts/mac/sincronizar-pstack.sh).
  Install:
    cp scripts/mac/sincronizar-pstack.sh scripts/mac/pstack-arranque.sh ~/bin/ &&
    cp scripts/mac/ai.goncloud.sincronizar-pstack.plist ~/Library/LaunchAgents/ &&
    launchctl bootstrap gui/501 ~/Library/LaunchAgents/ai.goncloud.sincronizar-pstack.plist
  Correr ya:
    launchctl kickstart gui/501/ai.goncloud.sincronizar-pstack
  Remove:
    launchctl bootout gui/501/ai.goncloud.sincronizar-pstack
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.goncloud.sincronizar-pstack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dn/bin/sincronizar-pstack.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/dn</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Una vez al día, hora de la Mac. Si la Mac dormía, launchd la corre al despertar. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/dn/Library/Logs/sincronizar-pstack.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dn/Library/Logs/sincronizar-pstack.log</string>
</dict>
</plist>
