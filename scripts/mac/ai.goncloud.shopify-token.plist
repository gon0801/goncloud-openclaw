<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Renovación automática del token de Shopify (scripts/mac/shopify-token/renueva.sh), 00:05 y 12:05
  hora de la Mac. Plantilla: __HOME__ y __RENUEVA__ los llena scripts/mac/shopify-token/desplegar.sh,
  que lo carga con `launchctl bootstrap gui/$(id -u)`. No usa crontab (en macOS se queda esperando
  un permiso de privacidad que nadie contesta).
  Remove: scripts/mac/shopify-token/rollback.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.goncloud.shopify-token</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RENUEVA__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>0</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>5</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/shopify-token.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/shopify-token.log</string>
</dict>
</plist>
