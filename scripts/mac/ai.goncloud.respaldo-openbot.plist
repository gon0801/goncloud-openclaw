<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Respaldo diario de OpenBot de la MacBook a gonserver (scripts/mac/respaldo-openbot.sh).
  Plantilla: __HOME__ se llena al instalar. La MacBook es una laptop: si a las 03:45 está
  dormida, launchd corre el trabajo al despertar.
  Install, en la MacBook como David:
    mkdir -p ~/bin ~/Library/Logs/goncloud &&
    cp scripts/mac/respaldo-openbot.sh scripts/mac/respaldo-comun.sh ~/bin/ &&
    sed -e "s|__HOME__|$HOME|g" \
      scripts/mac/ai.goncloud.respaldo-openbot.plist > ~/Library/LaunchAgents/ai.goncloud.respaldo-openbot.plist &&
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.goncloud.respaldo-openbot.plist
  Correr ya (sin esperar a las 03:45):
    launchctl kickstart gui/$(id -u)/ai.goncloud.respaldo-openbot
  Remove:
    launchctl bootout gui/$(id -u)/ai.goncloud.respaldo-openbot
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.goncloud.respaldo-openbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/bin/respaldo-openbot.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/goncloud/respaldo-openbot.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/goncloud/respaldo-openbot.log</string>
</dict>
</plist>
