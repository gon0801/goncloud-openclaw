<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vigía semanal del rebase del gateway R (scripts/mac/vigia-rebase-r.sh): mide
  cuánto se alejó la versión pública de OpenClaw de nuestra rama de integración
  y avisa por Telegram una sola vez por versión.
  Install:
    mkdir -p ~/bin ~/Library/Logs/goncloud &&
    cp scripts/mac/vigia-rebase-r.sh ~/bin/ &&
    cp scripts/mac/ai.goncloud.vigia-rebase-r.plist ~/Library/LaunchAgents/ &&
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.goncloud.vigia-rebase-r.plist
  Correr ya (sin esperar al lunes 09:00):
    launchctl kickstart gui/$(id -u)/ai.goncloud.vigia-rebase-r
  Remove:
    launchctl bootout gui/$(id -u)/ai.goncloud.vigia-rebase-r
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.goncloud.vigia-rebase-r</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dn/bin/vigia-rebase-r.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/dn</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Los lunes a las 09:00, hora de la Mac. Si dormía, launchd la corre al despertar. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/dn/Library/Logs/goncloud/vigia-rebase-r.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dn/Library/Logs/goncloud/vigia-rebase-r.log</string>
</dict>
</plist>
